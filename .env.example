# Copy to .env and fill in.  bot_runner.py loads .env via python-dotenv.

# --- Unusual Whales ---
# Leave it empty to run MANUAL-ONLY: the bot's flow feed, regimes and rules are
# off; Webull quotes, the manual desk, the viewer and Telegram still run.
UW_API_KEY=
# The WebSocket needs UW's Advanced plan. On Basic set this to false: the flow
# trigger runs on REST net-prem-ticks (the same source the backtests were built
# on). Left true on a plan without the socket, the client tries once, logs one
# message and falls back -- false just skips the attempt.
# UW_WEBSOCKET=false

# --- Viewer market data (see webull_viewer_data.py) ---
# auto (default): Unusual Whales when UW_API_KEY is set, otherwise Webull.
# webull: the GEX heat (0-1DTE, weekly, +index), VWAP / volume / RVOL and the
#   strike strip's volume and OI come from Webull even with a UW key set.
#   Not available from Webull: cumulative flow, sweeps, and the all-expiry
#   walls and gamma flip. Chosen once at startup and shown on the chart.
# VIEWER_DATA=auto

# --- Webull (directional executor) ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=

# --- Hyperliquid perp hedge (OFF BY DEFAULT — see below) ---
# MAIN_WALLET alone gives a READ-ONLY client: balances and positions, no signing.
# AGENT_SECRET adds signing. Generate one with
# HyperExposureClient.generate_agent(<master key>) and never paste the master
# key into this file.
MAIN_WALLET=
AGENT_SECRET=

# --- Hyperliquid EXECUTION LOCK ---
# 🚨 READ hl_gate.py's LEGAL_NOTICE BEFORE TOUCHING ANY OF THESE.
#     python hl_gate.py     # prints the notice and the current arm state
#
# Hyperliquid perpetuals are leveraged derivatives on an offshore, unregistered
# venue. FOR US PERSONS THEY ARE GENERALLY NOT LAWFUL TO TRADE unless you meet
# the "eligible contract participant" threshold, which ordinary retail traders
# do not. The rest of this toolkit runs completely without this feature; leaving
# every line below unset is the correct configuration for almost everyone.
#
# FOUR things must all be true before an entry is sent. Each defaults to the
# safe end, and an unset cap refuses everything rather than permitting anything.
# Risk-REDUCING orders (flatten, stop-loss, take-profit, cancel) ignore all of
# it by design — a position you hold must always be closeable.
#
# HL_TRADING_ENABLED=true
# HL_LEGAL_ACK="I HAVE READ THE HYPERLIQUID LEGAL NOTICE AND I AM ELIGIBLE"
# HL_ALLOWED_COINS=SP500          # comma-separated; empty = nothing permitted
# HL_MAX_NOTIONAL_USD=500         # per order, size x price; 0/unset = refuse all
# HL_MAX_LEVERAGE=1               # default 1 (none). Leverage is liquidation.
# HL_DRY_RUN=false                # honoured ONLY when DRY_RUN is already false

# --- Rithmic (unused by the directional bot) ---
RITHMIC_USER=
RITHMIC_PWD=
# The app-name string Rithmic assigned you; login is rejected without an exact
# match. rithmic_protos/ is not published with this repo -- see NOTICE.
RITHMIC_APP_NAME=

# --- Safety toggles (see config.py) ---
# DRY_RUN=true            # nothing places a live order unless explicitly false
# PAPER_TRADING=false     # Webull sandbox endpoint
# USE_RULES=true
# MANUAL_TRADING_ARMED=false   # the discretionary desk in the viewer

# Most of your option buying power that ONE discretionary order may spend.
# Default 0.20. It was 1.0 -- no limit at all -- which was only ever defensible
# while the account held test money. Raise it deliberately; it is a fraction of
# REAL buying power, so it tightens on its own as the account shrinks.
# MANUAL_MAX_PREMIUM_PCT=0.20

# --- Telegram trade notifications (optional) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token
# 2. Message your new bot anything, then open:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy result[0].message.chat.id  (a number, may be negative for groups)
# 3. Fill both in below and restart the bot.  Absent -> notifications simply OFF.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- misc ---
# FLOW_TRIGGER_LOG=flow_trigger_log.jsonl
# FLOW_THRESHOLDS_PATH=flow_pct_thresholds.json
